{
    "name": "freeshow",
    "version": "1.14.0",
    "private": true,
    "main": "build/electron/index.js",
    "description": "FreeShow - CCFII Edition: Show song lyrics and more for free!",
    "repository": "git@github.com:ccfii-engineering/ccfii-free-show.git",
    "author": "ChurchApps <support@livecs.org>",
    "license": "GPL-3.0",
    "scripts": {
        "postinstall": "electron-builder install-app-deps",
        "---DEVELOPMENT---": "",
        "start": "node scripts/start.js",
        "start:old": "npx cross-env NODE_ENV=development npm-run-all -p -r build:frontend:dev start:electron",
        "build:frontend:dev": "npx cross-env NODE_ENV=development vite",
        "start:electron": "npm-run-all -s build:powerpoint-renderer && npm-run-all -p build:electron:dev:watch start:electron:dev",
        "build:electron:dev:watch": "node node_modules/typescript7/bin/tsc -w --p config/typescript/tsconfig.electron.json",
        "start:electron:dev": "npm-run-all -s build:electron:dev start:electron:script start:electron:run",
        "build:electron:dev": "node node_modules/typescript7/bin/tsc --p config/typescript/tsconfig.electron.json",
        "start:electron:script": "node scripts/electronDevPostBuild.js",
        "start:electron:run": "electron .",
        "---PRODUCTION---": "",
        "prebuild": "cross-env NODE_ENV=production node scripts/preBuild.js",
        "build": "cross-env NODE_ENV=production npm-run-all -s build:frontend:prod build:servers:prod build:electron:prod",
        "postbuild": "cross-env NODE_ENV=production node scripts/postBuild.js",
        "build:frontend:prod": "cross-env NODE_ENV=production vite build",
        "build:servers:prod": "cross-env NODE_ENV=production node scripts/vite/createServerFiles.js",
        "build:servers:dev": "cross-env NODE_ENV=development node scripts/vite/createServerFiles.js",
        "build:electron:prod": "npm-run-all -s build:powerpoint-renderer build:electron:prod:tsc",
        "build:electron:prod:tsc": "cross-env NODE_ENV=production node node_modules/typescript7/bin/tsc --p config/typescript/tsconfig.electron.prod.json",
        "build:powerpoint-renderer": "vite build --config config/powerpoint-renderer.vite.config.mjs",
        "---RELEASE---": "",
        "prerelease": "npm run build",
        "release": "electron-builder --config config/building/electron-builder.yaml --publish always",
        "release:internal": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config config/building/electron-builder.internal.js --publish always",
        "postrelease": "node scripts/cleanBuilds.js",
        "prerelease:arm64": "npm run build",
        "release:arm64": "electron-builder --config config/building/electron-builder-lnxarm.yaml --arm64 --publish onTagOrDraft",
        "postrelease:arm64": "node scripts/cleanBuilds.js",
        "pack": "electron-builder --config config/building/electron-builder.yaml --dir",
        "dist:internal": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config config/building/electron-builder.internal.js --publish never",
        "pack:arm64": "electron-builder --config config/building/electron-builder-lnxarm.yaml --dir",
        "replace-electron": "node config/building/electron-replace-lnxarm.js",
        "---CHECKING---": "",
        "test": "npm-run-all -s test:unit test:playwright test:format test:svelte",
        "test:unit": "npm-run-all -s test:unit:node test:unit:playback test:unit:imports test:unit:remote test:unit:templates test:unit:editor test:unit:outputs",
        "test:unit:node": "node --test scripts/tests/*.test.mjs",
        "test:unit:playback": "vitest run --config config/testing/vitest.config.ts src/electron/IPC/main.test.ts src/electron/capture/helpers/CaptureTransmitter.test.ts src/electron/ndi/NdiSender.test.ts src/electron/servers.test.ts src/frontend/IPC/main.test.ts scripts/tests/video-player-playback-control.test.ts src/frontend/components/media/video/outputSeekTracker.test.ts",
        "test:unit:imports": "vitest run --config config/testing/vitest.config.ts src/electron/output/ppt/pptToShow.test.ts src/electron/data/renderedPowerPointImport.test.ts src/electron/testEnvironment.test.ts",
        "test:unit:templates": "vitest run --config config/testing/vitest.config.ts src/frontend/components/helpers/slideTemplateMerge.test.ts src/frontend/components/helpers/pureHelpers.test.ts src/frontend/components/output/tools/mediaControlsBackground.test.ts",
        "test:unit:editor": "vitest run --config config/testing/vitest.config.ts src/common/templates/templateInUse.test.ts src/common/lyrics/analyzeLyricsText.test.ts --maxWorkers=1",
        "test:unit:outputs": "vitest run --config config/testing/vitest.config.ts src/frontend/utils/runeRecordStore.test.ts src/frontend/outputState/outputs.test.ts src/frontend/outputState/outputs.measurement.test.ts src/frontend/utils/runeRecordStore.lazyDraft.test.ts src/frontend/mediaState/media.test.ts src/frontend/showsCacheState/showsCache.test.ts src/frontend/utils/recordStores.measurement.test.ts --maxWorkers=1",
        "test:unit:remote": "vitest run --config config/testing/vitest.config.ts src/electron/utils/remoteMedia.test.ts src/frontend/utils/sendData.remoteMedia.test.ts src/frontend/utils/remoteProtocol.contract.test.ts src/frontend/utils/stageControllerProtocol.contract.test.ts src/server/common/util/webClient.test.ts src/frontend/utils/remoteMediaViews.test.ts src/frontend/utils/controllerPresenter.test.ts src/frontend/components/helpers/OutputHelper.presenter.test.ts",
        "test:electron-runtime": "node scripts/tests/runElectronRuntime.mjs",
        "test:powerpoint-renderer:electron": "npm run build:powerpoint-renderer && npm run build:electron:dev && node scripts/tests/runPowerpointRendererElectron.mjs",
        "test:playwright": "npx playwright test --config config/testing/playwright.config.ts",
        "test:format": "npx prettier --config config/formatting/.prettierrc.yaml --check src scripts",
        "test:svelte": "svelte-check",
        "typecheck": "node scripts/typecheck.mjs",
        "typecheck:electron": "node scripts/typecheck.mjs electron",
        "typecheck:server": "node scripts/typecheck.mjs server",
        "typecheck:frontend": "node scripts/typecheck.mjs frontend",
        "format:prettier": "npx prettier --config config/formatting/.prettierrc.yaml --write src scripts",
        "lint": "npm-run-all -s lint:electron lint:frontend lint:svelte lint:styles",
        "lint:electron": "eslint -c config/linting/eslint.electron.config.mjs src/electron --fix",
        "lint:frontend": "eslint -c config/linting/eslint.frontend.config.mjs src/frontend --fix",
        "lint:svelte": "eslint -c config/linting/eslint.svelte.config.mjs src/frontend --fix",
        "lint:styles": "npx stylelint 'src/frontend/**/*.{css,scss,svelte}' --config config/linting/.stylelintrc.json"
    },
    "devDependencies": {
        "@electron/notarize": "^2.5.0",
        "@mapbox/node-pre-gyp": "^2.0.0",
        "@playwright/test": "^1.56.1",
        "@rollup/plugin-commonjs": "^28.0.6",
        "@rollup/plugin-node-resolve": "^15.3.1",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.1.4",
        "@soundtouchjs/audio-worklet": "^1.0.10",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tsconfig/svelte": "^2.0.1",
        "@types/better-sqlite3": "^7.6.13",
        "@types/ebml": "^3.0.5",
        "@types/exif": "^0.6.5",
        "@types/express": "^4.17.23",
        "@types/follow-redirects": "^1.14.4",
        "@types/tmp": "^0.2.6",
        "@types/vimeo__player": "^2.18.3",
        "@types/xml2js": "^0.4.14",
        "@types/yauzl": "^2.10.3",
        "@types/yazl": "^3.3.0",
        "@typescript-eslint/parser": "^8.72.1",
        "cross-env": "^7.0.3",
        "electron": "^45.2.3",
        "electron-builder": "^26.0.19",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^65.4.4",
        "eslint-plugin-svelte": "^3.24.0",
        "firebase": "^12.17.1",
        "globals": "^17.14.0",
        "npm-run-all": "^4.1.5",
        "npm-run-all2": "^9.0.3",
        "playwright": "^1.56.1",
        "prettier": "^3.6.2",
        "prettier-plugin-svelte": "^3.4.0",
        "rollup": "^4.46.2",
        "rollup-plugin-copy": "^3.5.0",
        "rollup-plugin-css-only": "^4.5.2",
        "rollup-plugin-livereload": "^2.0.5",
        "rollup-plugin-serve": "^3.0.0",
        "rollup-plugin-svelte": "^7.2.2",
        "stylelint": "^16.23.1",
        "stylelint-config-html": "^1.1.0",
        "stylelint-use-logical": "^2.1.2",
        "svelte": "^5.57.3",
        "svelte-check": "^4.7.8",
        "svelte-eslint-parser": "^1.10.1",
        "svelte-inspector": "github:vassbo/svelte-inspector#78307db",
        "svelte-preprocess": "^6.0.5",
        "tmp": "^0.2.7",
        "tslib": "^2.8.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "typescript7": "npm:typescript@^7.0.2",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "@discordjs/opus": "^0.11.0",
        "@googleapis/drive": "^27.0.0",
        "@sentry/electron": "^7.16.0",
        "@tanstack/pacer": "^0.14.0",
        "@vimeo/player": "^2.29.3",
        "@web-ppt/core": "0.4.5",
        "axios": "^1.12.2",
        "better-sqlite3": "^13.0.3",
        "bonjour-service": "^1.3.0",
        "chord-transposer": "^3.0.9",
        "dayjs": "^1.11.13",
        "ebml": "^3.0.0",
        "electron-store": "^8.2.0",
        "electron-updater": "^6.6.7",
        "exif": "^0.6.0",
        "express": "^4.21.2",
        "fast-xml-parser": "^5.11.0",
        "follow-redirects": "^1.15.11",
        "genius-lyrics": "^4.4.7",
        "grandiose": "github:ChurchApps/grandiose#4e02dea",
        "html-to-image": "^1.11.13",
        "json-bible": "^1.1.9",
        "jzz": "^1.9.5",
        "libltc-wrapper": "github:bitfocus/libltc-wrapper#9637e39",
        "libreoffice-convert": "^1.6.1",
        "macadam": "github:vassbo/macadam#d40f0a3",
        "mdb-reader": "^1.2.1",
        "mp4box": "^0.6.5",
        "music-metadata": "^12.3.5",
        "node-machine-id": "^1.1.12",
        "osc-js": "^2.4.1",
        "pcm-convert": "^1.6.5",
        "pdfjs-dist": "^5.4.296",
        "protobufjs": "^7.5.3",
        "pusher-js": "^8.6.0",
        "qrcode-generator": "^1.5.2",
        "slideshow": "github:vassbo/slideshow#224d50f",
        "socket.io": "^4.8.1",
        "socket.io-client": "^4.8.1",
        "uid": "^2.0.2",
        "upath": "^2.0.1",
        "word-extractor": "^1.0.4",
        "xml2js": "^0.6.2",
        "yauzl": "^3.2.0",
        "yazl": "^3.3.1",
        "youtube-player": "^5.6.0"
    },
    "overrides": {
        "qs": "^6.17.1",
        "@discordjs/node-pre-gyp": {
            "tar": "^7.5.22"
        },
        "grandiose": {
            "tmp": "^0.2.7"
        }
    }
}
